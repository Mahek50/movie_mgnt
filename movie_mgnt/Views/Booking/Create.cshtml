@model movie_mgnt.Models.booking

@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int currentCatId = Model != null ? Model.cat_id : 0;
    int currentMovieId = Model != null ? Model.movie_id : 0;
}

@if (ViewBag.Message != null)
{
    <div class="alert alert-success">
        @ViewBag.Message
    </div>
}
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

<h2>Create</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <h4>Booking</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="form-group">
            @Html.LabelFor(model => model.cat_id, "Category", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <select id="cat_id" name="cat_id" class="form-control" onchange="window.location.href = '@Url.Action("Create", "Booking")?cat_id=' + this.value;">
                    <option value="">--Select Category--</option>
                    @if (ViewBag.CategoryList != null)
                    {
                        foreach (var item in ViewBag.CategoryList)
                        {
                            <option value="@item.Value" @(item.Value == currentCatId.ToString() ? "selected" : "")>
                                @item.Text
                            </option>
                        }
                    }
                </select>
                @Html.ValidationMessageFor(model => model.cat_id, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.movie_id, "Movie Name", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <select id="movie_id" name="movie_id" class="form-control" onchange="window.location.href = '@Url.Action("Create", "Booking")?cat_id=@currentCatId&movie_id=' + this.value;">
                    <option value="">--Select Movie--</option>
                    @if (ViewBag.MovieList != null)
                    {
                        foreach (var item in ViewBag.MovieList)
                        {
                            <option value="@item.Value" @(item.Value == currentMovieId.ToString() ? "selected" : "")>
                                @item.Text
                            </option>
                        }
                    }
                </select>
                @Html.ValidationMessageFor(model => model.movie_id, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.no_tickets, "No Of Ticket", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <input type="number" id="no_tickets" name="no_tickets" class="form-control" value="@(Model != null ? Model.no_tickets : 1)" min="1" 
                       onchange="window.location.href='@Url.Action("Create", "Booking")?cat_id=@currentCatId&movie_id=@currentMovieId&no_tickets=' + this.value;" />
                @Html.ValidationMessageFor(model => model.no_tickets, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.amount, "Amount", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <input type="text" class="form-control" value="@ViewBag.TotalPrice" disabled />
                <input type="hidden" name="amount" value="@ViewBag.TotalPrice" />
                @Html.ValidationMessageFor(model => model.amount, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Create" class="btn btn-default" />
            </div>
        </div>
    </div>
}

<div>
    @Html.ActionLink("Back to List", "Index")
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}